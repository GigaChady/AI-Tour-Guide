# AI mode
# true  -> mock w/o Ollama
# false -> live pipeline (disabled for now)
AI_MOCK=False

# Compose profiles: blank for mock, "llm" for live pipeline
COMPOSE_PROFILES=

# Ollama configuration
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=mistral-nemo

# Redis stream worker
REDIS_URL=redis://redis:6379/0
AI_STREAM_KEY=location:events
AI_PUBSUB_PREFIX=tour:

# Python configuration
PYTHONUNBUFFERED=1

# Google Gemini Cloud Api
GEMINI_API_KEY=-
CLOUD_NARRATIVE_MODEL_NAME=gemini-flash-lite-latest
CLOUD_NARRATIVE_THINKING_LEVEL=HIGH
CLOUD_NARRATIVE_REQUEST_TIMEOUT_SECONDS=45
CLOUD_NARRATIVE_MAX_RETRIES=1